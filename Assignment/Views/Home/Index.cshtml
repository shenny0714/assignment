@{
    ViewBag.Title = "Home";
    Layout = "_Layout";
    var today = DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="container-2">

    <section class="section-1">
        <div class="content-1">
            <h1 class="title-1">Find Your Perfect Ride, Effortlessly.</h1>
            <h2 class="subtitle-1">
                Rent from a wide range of premium cars at unbeatable prices.
            </h2>
        </div>
        <button class="btn-primary btn-1">Book Now</button>
    </section>

    <section class="widget-box">
        <form action="/CarCatalog" method="get">

            <div class="form-grid">

                <div class="input-group">
                    <label>Pick-up Date</label>
                    <input class="form-input"
                           type="date"
                           name="pickedDate"
                           value="@today"
                           min="@today"
                           required />
                </div>

                <div class="input-group">
                    <label>Car Type</label>
                    <select class="form-input" name="SelectedCategory">
                        <option value="">All Types</option>
                        <option value="City">City</option>
                        <option value="Sedan">Sedan</option>
                        <option value="SUV">SUV</option>
                        <option value="Luxury">Luxury</option>
                    </select>
                </div>

                <button type="submit" class="btn-primary btn-search">Search Cars</button>
            </div>

        </form>
    </section>

    <section>
        <h2 class="section-header">Browse by Category</h2>
        <div class="car-grid">

            <div class="car-card">
                <img src="~/images/car3.jpg" alt="City Car" class="car-img" />
                <div class="car-details">
                    <h3 class="car-title">City</h3>
                    <div class="car-features">
                        <span>Easy Parking</span> | <span>Fuel Efficient</span>
                    </div>
                    <div class="price-row">
                        <p class="price-tag">Best for<span class="price-suffix"> Commute</span></p>

                        <a href="/CarCatalog?SelectedCategory=City" class="btn-primary btn-rent">View Cars</a>
                    </div>
                </div>
            </div>

            <div class="car-card">
                <img src="~/images/car2.jpg" alt="Sedan" class="car-img" />
                <div class="car-details">
                    <h3 class="car-title">Sedan</h3>
                    <div class="car-features">
                        <span>Comfort</span> | <span>Spacious</span> | <span>Style</span>
                    </div>
                    <div class="price-row">
                        <p class="price-tag">Best for<span class="price-suffix"> Business</span></p>

                        <a href="/CarCatalog?SelectedCategory=Sedan" class="btn-primary btn-rent">View Cars</a>
                    </div>
                </div>
            </div>

            <div class="car-card">
                <img src="~/images/car1.jpg" alt="SUV" class="car-img" />
                <div class="car-details">
                    <h3 class="car-title">SUV</h3>
                    <div class="car-features">
                        <span>Family Size</span> | <span>Large Boot</span>
                    </div>
                    <div class="price-row">
                        <p class="price-tag">Best for<span class="price-suffix"> Travel</span></p>

                        <a href="/CarCatalog?SelectedCategory=SUV" class="btn-primary btn-rent">View Cars</a>
                    </div>
                </div>
            </div>

        </div>
    </section>

</div>