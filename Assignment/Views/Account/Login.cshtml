@model Assignment.ViewModels.LoginVM
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/login.css">

<div class="auth-wrapper">
    <div class="auth-card">

        <div class="tab-header">
            <a href="#" class="tab-link active">LOGIN</a>
            <a href="/Account/Register" class="tab-link">REGISTER</a>
        </div>

        <div class="auth-content">
            <div class="divider"></div>

            <form method="post" asp-action="Login">
                
                <div asp-validation-summary="ModelOnly" class="text-danger" style="text-align:center; margin-bottom:10px;"></div>

                <div class="form-group">
                    <label for="text">Email</label>
                    <input asp-for="Email" class="input-box"  />
                    <span asp-validation-for="Email" class="text-danger" style="font-size:12px;"></span>
                </div>

                <div class="form-group">
                    <label for="text">Password</label>
                    <input asp-for="Password" type="password" class="input-box"  />
                    <span asp-validation-for="Password" class="text-danger" style="font-size:12px;"></span>
                </div>

                <div class="options">
                    <label><input asp-for="RememberMe" /> Remember me</label>
                    <a href="#" class="link">Forgot password?</a>
                </div>

                <button type="submit" class="btn-main">SIGN IN</button>
                @if (ViewBag.Error != null)
                {
                    <div class="error">@ViewBag.Error</div>
                }
            </form>
        </div>
    </div>
</div>

