@model Assignment.ViewModels.LoginVM
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* --- Success Register Message --- *@
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert" style="box-shadow: 0 4px 6px rgba(0,0,0,0.1); margin: 20px auto; max-width: 500px;">
        <i class="fa-solid fa-check-circle me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@* -------------------------------- *@
<link rel="stylesheet" href="~/css/login.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="auth-wrapper">
    <div class="auth-card">

        <div class="tab-header">
            <a href="#" class="tab-link active">LOGIN</a>
            <a href="/Account/Register" class="tab-link">REGISTER</a>
        </div>

        <div class="auth-content">
            <div class="divider"></div>

            <form method="post" asp-action="Login">
                
                <div asp-validation-summary="ModelOnly" class="text-danger" style="text-align:center; margin-bottom:10px;"></div>

                <div class="form-group">
                    <label for="text">Email</label>
                    <input asp-for="Email" class="input-box"  />
                    <span asp-validation-for="Email" class="text-danger" style="font-size:12px;"></span>
                </div>

                <div class="form-group">
                    <label for="text">Password</label>
                    <input asp-for="Password" type="password" class="input-box"  />
                    <span asp-validation-for="Password" class="text-danger" style="font-size:12px;"></span>
                </div>

                <div class="options">
                    <label><input asp-for="RememberMe" /> Remember me</label>
                    <a href="/Account/ForgotPass" class="link">Forgot password?</a>
                </div>

                <button type="submit" class="btn-main">SIGN IN</button>
                @if (ViewBag.Error != null)
                {
                    <div class="error">@ViewBag.Error</div>
                }
            </form>
        </div>
    </div>
</div>

