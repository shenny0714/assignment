@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<Assignment.Models.Customer>
@{
    Layout = null;
    var adminName = User.Identity.Name;

    // Helper functions for Sorting logic
    string GetSortDir(string col) => col == ViewBag.Sort ? (ViewBag.Dir == "des" ? "asc" : "des") : "asc";
    string GetSortClass(string col) => col == ViewBag.Sort ? (ViewBag.Dir == "des" ? "sort-desc" : "sort-asc") : "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin - Customer Management</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/portal.css" />
</head>
<body>

    <div class="admin-container">

        <aside class="sidebar">
            <div class="user-widget">
                <div class="user-info-row">
                    <div class="user-avatar">
                        <i class="fa-solid fa-user-secret"></i>
                    </div>
                    <div class="user-details">
                        <span class="user-name">@adminName</span>
                        <span class="user-role">Administrator</span>
                    </div>
                </div>
            </div>

            <nav class="side-nav">
                <div class="nav-label">ADMIN PANEL</div>
                <ul>
                    <li class="active">
                        <a href="/Account/Admin"><i class="fas fa-users"></i><span>Customers</span></a>
                    </li>
                    <li>
                        <a href="/Account/AdminStaff"><i class="fas fa-user-tie"></i><span>Staff</span></a>
                    </li>
                    <li><a href="#"><i class="fas fa-car"></i><span>Rentals</span></a></li>
                    <li><a href="#"><i class="fas fa-chart-line"></i><span>Reports</span></a></li>
                </ul>
            </nav>

            <div class="logout-wrap">
                <a href="/Account/Logout" class="logout-btn"><i class="fas fa-power-off"></i> Logout</a>
            </div>
        </aside>

        <main class="main-content">
            <header class="top-bar">
                <h1>Customer Management</h1>
            </header>

            <div class="content-area">

                @if (TempData["Success"] != null)
                {
                    <div class="alert-box alert-success">
                        <span><i class="fa-solid fa-check-circle"></i> @TempData["Success"]</span>
                        <button class="alert-close" onclick="this.parentElement.style.display='none'">&times;</button>
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert-box alert-error">
                        <span><i class="fa-solid fa-triangle-exclamation"></i> @TempData["Error"]</span>
                        <button class="alert-close" onclick="this.parentElement.style.display='none'">&times;</button>
                    </div>
                }

                <form class="toolbar" method="get">
                    <div class="search-group">
                        <i class="fas fa-search"></i>
                        @Html.TextBox("name", (string)ViewBag.Name, new { placeholder = "Search Customers...", autocomplete = "off" })
                    </div>

                    @Html.Hidden("sort", (string)ViewBag.Sort)
                    @Html.Hidden("dir", (string)ViewBag.Dir)

                    <button type="submit" class="btn-search">Search</button>

                    <a href="/Account/Admin" class="btn-reset" title="Reset">
                        <i class="fa-solid fa-rotate-right"></i>
                    </a>
                </form>

                <p class="record-info">
                    Showing @Model.Count() of @Model.TotalItemCount record(s) | Page @Model.PageNumber of @Model.PageCount
                </p>

                <div class="table-card">
                    <table class="styled-table">
                        <thead>
                            <tr>
                                <th>
                                    <a href="?name=@ViewBag.Name&sort=Id&dir=@GetSortDir("Id")" class="@GetSortClass("Id")">
                                        ID <i class="fa-solid fa-sort"></i>
                                    </a>
                                </th>
                                <th>Photo</th>
                                <th>
                                    <a href="?name=@ViewBag.Name&sort=Name&dir=@GetSortDir("Name")" class="@GetSortClass("Name")">
                                        Name <i class="fa-solid fa-sort"></i>
                                    </a>
                                </th>
                                <th>
                                    <a href="?name=@ViewBag.Name&sort=Email&dir=@GetSortDir("Email")" class="@GetSortClass("Email")">
                                        Email <i class="fa-solid fa-sort"></i>
                                    </a>
                                </th>
                                <th>Phone</th>
                                <th style="text-align:center;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="id-cell">#@item.CustomerId</td>
                                    <td>
                                        <div class="table-img-wrap">
                                            @if (!string.IsNullOrEmpty(item.PhotoURL))
                                            {
                                                <img src="~/photos/@item.PhotoURL" alt="User" />
                                            }
                                            else
                                            {
                                                <div class="table-avatar-placeholder">
                                                    @item.Name.Substring(0, 1).ToUpper()
                                                </div>
                                            }
                                        </div>
                                    </td>
                                    <td class="name-cell">@item.Name</td>
                                    <td>@item.Email</td>
                                    <td>@item.Phone</td>
                                    <td style="text-align:center;">
                                        <a href="/Account/EditUser/@item.CustomerId" class="btn-edit">
                                            <i class="fas fa-pen"></i> Edit
                                        </a>

                                        <form asp-action="DeleteCustomer" asp-route-id="@item.CustomerId" method="post" onsubmit="return confirm('Are you sure you want to delete this customer?');" style="display:inline;">
                                            <button type="submit" class="btn-delete">
                                                <i class="fas fa-trash"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="6" style="text-align:center; padding: 40px; color:#888;">
                                        <i class="fa-solid fa-folder-open" style="font-size:2rem; margin-bottom:10px;"></i>
                                        <p>No customers found.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @*if (Model.PageCount > 1)*@
                @*{*@
                <div class="pagination-wrapper">
                    <a href="@Url.Action("Admin", new { page = Model.PageNumber - 1, name = ViewBag.Name, sort = ViewBag.Sort, dir = ViewBag.Dir })"
                       class="btn-page @(Model.HasPreviousPage ? "" : "disabled")">
                        &laquo; Prev
                    </a>

                    <span class="page-info-box">
                        @Model.PageNumber of @Model.PageCount
                    </span>

                    <a href="@Url.Action("Admin", new { page = Model.PageNumber + 1, name = ViewBag.Name, sort = ViewBag.Sort, dir = ViewBag.Dir })"
                       class="btn-page @(Model.HasNextPage ? "" : "disabled")">
                        Next &raquo;
                    </a>
                </div>
                @*}*@

            </div>
        </main>
    </div>
</body>
</html>