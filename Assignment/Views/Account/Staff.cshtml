@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<Assignment.Models.Customer>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Customer Records";
    var staffName = User.Identity.Name;
    var staffPhoto = User.FindFirst("PhotoURL")?.Value;

    // Helper function to generate Sort Links (Based on Demo logic)
    string GetSortDir(string column)
    {
        if (column == ViewBag.Sort)
            return ViewBag.Dir == "des" ? "asc" : "des";
        return "asc";
    }

    string GetSortClass(string column)
    {
        if (column == ViewBag.Sort)
            return ViewBag.Dir == "des" ? "sort-desc" : "sort-asc";
        return "";
    }
}


<div class="content-area">

    <form class="toolbar" method="get">
        <div class="search-group">
            <i class="fa-solid fa-magnifying-glass"></i>
            @Html.TextBox("name", (string)ViewBag.Name, new { placeholder = "Enter Keywords...", autocomplete = "off" })
        </div>

        @Html.Hidden("sort", (string)ViewBag.Sort)
        @Html.Hidden("dir", (string)ViewBag.Dir)

        <button type="submit" class="btn-search">Search</button>

        <a href="/Account/Staff" class="btn-reset" title="Reset"><i class="fa-solid fa-rotate-right"></i></a>
    </form>

    <p class="record-info">
        Showing @Model.Count() of @Model.TotalItemCount record(s) | Page @Model.PageNumber of @Model.PageCount
    </p>

    <div class="table-card">
        <table class="styled-table">
            <thead>
                <tr>
                    <th>
                        <a href="?name=@ViewBag.Name&sort=Id&dir=@GetSortDir("Id")" class="@GetSortClass("Id")">
                            ID <i class="fa-solid fa-sort"></i>
                        </a>
                    </th>
                    <th>Photo</th>
                    <th>
                        <a href="?name=@ViewBag.Name&sort=Name&dir=@GetSortDir("Name")" class="@GetSortClass("Name")">
                            Full Name <i class="fa-solid fa-sort"></i>
                        </a>
                    </th>

                    <th>
                        <a href="?name=@ViewBag.Name&sort=Email&dir=@GetSortDir("Email")" class="@GetSortClass("Email")">
                            Email Address <i class="fa-solid fa-sort"></i>
                        </a>
                    </th>
                    <th>Phone Number</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="id-cell">#@item.CustomerId</td>
                        <td>
                            <div class="table-img-wrap">
                                @if (!string.IsNullOrEmpty(item.PhotoURL))
                                {
                                    <img src="~/photos/@item.PhotoURL" alt="User" />
                                }
                                else
                                {
                                    <div class="table-avatar-placeholder"><i class="fa-solid fa-user"></i></div>
                                }
                            </div>
                        </td>
                        <td class="name-cell">@item.Name</td>
                        <td class="email-cell">@item.Email</td>
                        <td>@item.Phone</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="empty-state">
                            <i class="fa-solid fa-folder-open"></i>
                            <p>No records found matching "@ViewBag.Name".</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="pagination-wrapper">

        <a href="@Url.Action("Staff", new { page = Model.PageNumber - 1, name = ViewBag.Name, sort = ViewBag.Sort, dir = ViewBag.Dir })"
            class="btn-page @(Model.HasPreviousPage ? "" : "disabled")">
            &laquo; Prev
        </a>

        <span class="page-info-box">
            @Model.PageNumber of @Model.PageCount
        </span>

        <a href="@Url.Action("Staff", new { page = Model.PageNumber + 1, name = ViewBag.Name, sort = ViewBag.Sort, dir = ViewBag.Dir })"
            class="btn-page @(Model.HasNextPage ? "" : "disabled")">
            Next &raquo;
        </a>

    </div>

</div>
   