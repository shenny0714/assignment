@model Assignment.ViewModels.UpdateProfileVM
@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/profile.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="profile-wrapper">

    @* --- Alerts Section --- *@
    <div id="alertContainer">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fa-solid fa-check-circle me-2"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fa-solid fa-exclamation-circle me-2"></i> @ViewBag.Error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show">
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>

    <form asp-action="Profile" method="post" enctype="multipart/form-data" id="mainProfileForm" novalidate>

        <header>
            <div class="header-cover"></div>
            <div class="profile-header-content">
                <div class="avatar-container">
                    @if (!string.IsNullOrEmpty(Model.PhotoURL))
                    {
                        <img src="~/photos/@Model.PhotoURL" class="avatar-image" />
                    }
                    else
                    {
                        <img src="https://ui-avatars.com/api/?name=@Model.Name&background=random" class="avatar-image" />
                    }
                </div>
                <h1 class="user-name">@Model.Name</h1>
                <p class="user-title">@Model.Email</p>
            </div>
        </header>

        <main class="main-content-panel">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="panel-title mb-0"><i class="fa-solid fa-user"></i> Personal Information</h2>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnEditProfile" onclick="toggleEditMode(true)">
                    <i class="fa-solid fa-pen"></i> Edit
                </button>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label class="label-txt">Full Name</label>
                    <input asp-for="Name" class="form-input" readonly id="inputName" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="label-txt">Email</label>
                    <input asp-for="Email" class="form-input" readonly style="opacity:0.7" />
                </div>

                <div class="form-group">
                    <label class="label-txt">Phone Number</label>
                    <input asp-for="PhoneNumber" class="form-input" placeholder="+123456789" readonly id="inputPhone" required />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <input type="hidden" asp-for="PhotoURL" />

                <div class="form-group hidden" id="photoUploadGroup">
                    <label class="label-txt">Change Profile Photo</label>
                    <input asp-for="Photo" type="file" class="form-control" accept=".jpg, .jpeg, .png" onchange="previewImage(this)" />

                    <div id="previewContainer" class="mt-3 text-center hidden">
                        <p class="small text-muted mb-1">Preview:</p>
                        <img id="previewImg" src="#" alt="Preview" style="width: 100px; height: 100px; object-fit: cover; border-radius: 50%; border: 3px solid var(--primary-color);" />
                    </div>
                </div>
            </div>

            <div class="mt-4 text-end hidden" id="personalInfoActions" style="border-top: 1px solid var(--border-color); padding-top: 20px;">
                <button type="button" class="btn-action btn-outline me-2" onclick="toggleEditMode(false)">Cancel</button>
                <button type="submit" class="btn-action btn-primary">Save Info</button>
            </div>
        </main>

        <main class="main-content-panel">
            <h2 class="panel-title"><i class="fa-solid fa-lock"></i> Security</h2>

            <div class="form-grid">
                <div class="form-group full-width">
                    <label class="label-txt">Current Password</label>
                    <input asp-for="CurrentPassword" type="password" class="form-input" id="CurrentPassword" />
                    <span id="err-current" class="text-danger" style="font-size: 0.85rem;"></span>
                </div>

                <div class="form-group">
                    <label class="label-txt">New Password</label>
                    <input asp-for="NewPassword" type="password" class="form-input" id="NewPassword" />
                    <span id="err-new" class="text-danger" style="font-size: 0.85rem;"></span>
                </div>

                <div class="form-group">
                    <label class="label-txt">Confirm Password</label>
                    <input asp-for="ConfirmNewPassword" type="password" class="form-input" id="ConfirmNewPassword" />
                    <span id="err-confirm" class="text-danger" style="font-size: 0.85rem;"></span>
                </div>
            </div>

            <div class="mt-4 text-end" style="border-top: 1px solid var(--border-color); padding-top: 20px;">
                <button type="submit" id="btnUpdatePass" class="btn-action btn-primary">Update Password</button>
            </div>
        </main>

    </form>
    <link rel="stylesheet" src="~/js/app.js" />
</div>

