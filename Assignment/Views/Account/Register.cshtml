@model Assignment.ViewModels.RegisterVM
@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<link rel="stylesheet" href="~/css/login.css" />

<div class="auth-wrapper">
    <div class="auth-card">

        <div class="tab-header">
            <a href="/Account/Login" class="tab-link">LOGIN</a>
            <a href="#" class="tab-link active">REGISTER</a>
        </div>

        <div class="auth-content">
            <form method="post" asp-action="Register" enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <h3 style="align-content: center;">Create Account</h3>

                <div class="form-group">

                    <input asp-for="Name" class="input-box" placeholder="Full Name" />
                    <span asp-validation-for="Name" class="text-danger" style="font-size:12px;"></span>
                </div>

                <div class="form-group">
                    <input asp-for="Email" class="input-box" placeholder="Email" />
                    <span asp-validation-for="Email" class="text-danger" style="font-size:12px;"></span>
                </div>

                <div class="form-group">
                    <input asp-for="Phone" class="input-box" placeholder="Phone Number" />
                    <span asp-validation-for="Phone" class="text-danger" style="font-size:12px;"></span>
                </div>

                <div class="form-group">
                    <input asp-for="Password" type="password" class="input-box" placeholder="Password" />
                    <span asp-validation-for="Password" class="text-danger" style="font-size:12px;"></span>
                </div>

                <div class="form-group">
                    <input asp-for="ConfirmPassword" type="password" class="input-box" placeholder="Confirm Password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:12px;"></span>
                </div>

                <div style="margin-bottom:15px;">
                    <label style="font-size:13px; color:#666; display:block; margin-bottom:5px;">Profile Photo (Optional)</label>
                    <input asp-for="Photo" type="file" class="input-box" style="padding:8px;" />
                    <span asp-validation-for="Photo" class="text-danger" style="font-size:12px;"></span>
                </div>

                <div class="form-group">
                    <label>Captcha</label>
                    <div>
                        <img src="/Account/GetCaptchaImage" alt="Captcha" style="border:1px solid #ccc; margin-bottom:5px;" />
                    </div>
                    <input type="text" name="captchaInput" class="input-box" placeholder="Enter code above" required />
                    @Html.ValidationMessage("Captcha", new { @class = "text-danger" })
                </div>

                <div class="options">
                    <label><input type="checkbox" required /> I agree to the terms & condition</label>
                </div>

                <div class="button-group">
                    <button type="submit" class="btn-main">SIGN UP</button>
                    <button type="reset" class="btn-reset">RESET</button>
                </div>


            </form>
        </div>
    </div>
</div>



