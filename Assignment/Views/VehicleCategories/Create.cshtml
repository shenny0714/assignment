@model Assignment.ViewModels.VehicleCategoryViewModel

@{
    ViewData["Title"] = "Create Vehicle Category";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">

<div class="d-flex justify-content-center mt-5">
    <div class="w-100" style="max-width: 400px;">

        <!-- Top Bar -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4>Create New Vehicle Category</h4>
            <a asp-action="Index" class="btn btn-secondary d-inline-flex align-items-center btn-sm">
                <i class="bi bi-arrow-left me-2"></i> Back
            </a>
        </div>

        <!-- Form Card -->
        <div class="card shadow-sm">
            <div class="card-body">

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Category Name -->
                    <div class="mb-3">
                        <label asp-for="CategoryName" class="form-label fw-bold">Category Name</label>
                        <input asp-for="CategoryName" class="form-control form-control-sm" placeholder="e.g. Sedan, SUV" />
                        <span asp-validation-for="CategoryName" class="text-danger small"></span>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-success w-100 btn-sm">Create Category</button>
                </form>

            </div>
        </div>

    </div>
</div>
    