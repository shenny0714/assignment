@model IEnumerable<Assignment.Models.CarModel>

@{
    ViewData["Title"] = "Admin | Model Management";
}

<link rel="stylesheet" href="~/css/vehicle.css" />
<div class="admin-container">

    <section class="admin-header">
        <div>
            <h2 class="admin-title">Car Model Management</h2>
        </div>
       
        <div class="admin-header-actions">

            <a asp-controller="Vehicle" asp-action="Inventory" class="btn btn-secondary">
                <i class="fas fa-list"></i> View All Inventory
            </a>

            <a asp-controller="Brand" asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-tag"></i> View vehicle Brand
            </a>

            <a asp-controller="VehicleCategories" asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-layer-group"></i> View vehicle Category
            </a>

            <a asp-controller="Vehicle" asp-action="Insert" class="btn btn-primary">
                <i class="fas fa-plus"></i> Create New Model
            </a>
        </div>
    </section>

    @if (Model.Any())
    {
        <div class="table-container">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Model</th>
                        <th>Brand</th>
                        <th>Category</th>
                        <th>Price / Day</th>
                        <th>Stock</th>
                        <th>Description</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="table-image">
                                    @if (!string.IsNullOrEmpty(item.ImagePathFront))
                                    {
                                        var imagename = @item.ImagePathFront;
                                        <img src="@item.ImagePathFront" alt="@item.ModelName" onerror="this.src='/images/@imagename'; this.onerror=null;" />
                                    }
                                    else
                                    {
                                        <div class="no-image">
                                            <i class="fas fa-car"></i>
                                        </div>
                                    }
                                </div>
                            </td>
                            <td>
                                <span class="model-name">@item.ModelName</span>
                            </td>
                            <td>
                                <span class="badge badge-brand">@item.Brand?.BrandName</span>
                            </td>
                            <td>
                                <span class="badge badge-category">@item.Category?.CategoryName</span>
                            </td>
                            <td>
                                <span class="price">RM @item.Price</span>
                            </td>
                            <td>
                                <span class="stock-badge">
                                    <i class="fas fa-layer-group"></i> @item.Vehicles.Count
                                </span>
                            </td>
                            <td>
                                <span class="description">@item.Description</span>
                            </td>
                            <td class="text-end">
                                <div class="table-actions">
                                    <a asp-controller="Vehicle" asp-action="Edit" asp-route-id="@item.ModelId" class="btn-action btn-edit" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon">
                <i class="fas fa-car"></i>
            </div>
            <h3>No models found</h3>
            <p>Start by clicking "Create New Model" to add your first vehicle model.</p>
        </div>
    }
</div>

<script>
    function confirmDelete(id) {
        if(confirm('Are you sure you want to delete this Model? This cannot be undone.')) {
            window.location.href = '/Vehicle/DeleteModel/' + id;
        }
    }
</script>
