@model Assignment.Models.Vehicle

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Add Inventory";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <!-- Card -->
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Step 2: Add Vehicle to Inventory</h4>
                </div>

                <div class="card-body">
                    <form asp-action="AddInventory" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <!-- Car Model -->
                        <div class="mb-3">
                            <label asp-for="ModelId" class="form-label fw-bold">Select Car Model</label>
                            <select asp-for="ModelId" class="form-select" asp-items="ViewBag.ModelId">
                                <option value="">-- Choose a Model --</option>
                            </select>
                            <small class="text-muted">Select the model you just created.</small>
                        </div>

                        <!-- Plate Number -->
                        <div class="mb-3">
                            <label asp-for="PlateNumber" class="form-label fw-bold">Plate Number</label>
                            <input asp-for="PlateNumber" class="form-control" placeholder="e.g. WAA 1234" required />
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-between">
                            <button type="button" class="btn btn-secondary" onclick="history.back();">
                                Back
                            </button>
                            <button type="submit" class="btn btn-success">Add to Inventory</button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>
