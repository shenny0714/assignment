@model IEnumerable<Assignment.Models.Vehicle>

@{
    ViewData["Title"] = "Vehicle Inventory";
}
<link rel="stylesheet" href="~/css/inventory.css" />
<div class="product-management-container">
    <a asp-action="Index" class="btn-back">← Back</a>
    <p></p>
    <div class="top-bar">
        <h2>Physical Vehicle Inventory</h2>
        
        <a asp-action="AddInventory" class="btn-add">+ Add New Plate</a>
    </div>

            <table class="product-table">
                <thead>
                    <tr>
                        <th>Vehicle ID</th>
                        <th>Car Model</th>
                        <th>Plate Number</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    Total count of @Model.Count() record(s)
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.VehicleId</td>
                            <td>
                                <strong>@item.Model?.Brand?.BrandName</strong> @item.Model?.ModelName
                            </td>
                            <td><span class="badge bg-secondary">@item.PlateNumber</span></td>
                           @*new*@
                            <td>
                                @if (item.Available)
                                {
                                    <span class="text-success fw-bold">
                                        <i class="fas fa-check-circle"></i> Available
                                    </span>
                                }
                                else
                                {
                                    <span class="text-danger fw-bold">
                                        <i class="fas fa-times-circle"></i> Unavailable
                                    </span>
                                }
                            </td>
                            <td>
                        <a asp-action="EditInventory" asp-route-id="@item.VehicleId" class="btn-edit">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                        <button onclick="deleteVehicle('@item.VehicleId')" class="btn-delete">
                                    <i class="fas fa-trash"></i> Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
        </table>
</div>

<script>
    function deleteVehicle(id) {
        if (confirm('Are you sure you want to delete this vehicle (ID: ' + id + ')?')) {
            // 创建一个隐藏表单来发送 POST 请求
            var form = document.createElement('form');
            form.method = 'POST';
            form.action = '/Vehicle/DeleteInventory/' + id;

            // 必须加入防伪 Token，否则会被 [ValidateAntiForgeryToken] 拦截
            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) {
                form.appendChild(token.cloneNode(true));
            }

            document.body.appendChild(form);
            form.submit();
        }
    }
    function updateStatus(id, newStatus) {
         // 创建一个隐藏表单
         var form = document.createElement('form');
         form.method = 'POST';
         // 这里的路径必须对应 Controller 的 Action
         form.action = '/Vehicle/UpdateStatus?id=' + id + '&status=' + newStatus;

         // 获取页面上的防伪 Token
         var token = document.querySelector('input[name="__RequestVerificationToken"]');
         if (token) {
             form.appendChild(token.cloneNode(true));
         }

         document.body.appendChild(form);
         form.submit();
     }
</script>