@model Assignment.ViewModels.ReserveVM

@{
    ViewData["Title"] = "Reserve Car";
    Layout = "_Layout";

    var carModel = ViewBag.SelectedModel as Assignment.Models.CarModel;

    string minStart = DateTime.Today.ToString("yyyy-MM-dd");
    string maxStart = DateTime.Today.AddDays(90).ToString("yyyy-MM-dd");
}

<link rel="stylesheet" href="~/css/reserve.css" asp-append-version="true" />

<style>
    .day-past {
        background-color: #e9ecef; /* Light Gray */
        color: #adb5bd;            /* Muted Text */
        cursor: not-allowed;
        pointer-events: none;      /* Prevent clicking */
    }
</style>

<div class="reserve-container-grid">
    <div class="row">

        <div class="col-lg-6 mb-4">
            <div class="reserve-card h-100">
                <div class="reserve-header">
                    <h3>Reserve: @(carModel.Brand?.BrandName ?? "") @carModel.ModelName</h3>
                </div>

                <div class="reserve-body">
                    <p class="note">
                        * You can book a car up to 3 months in advance.<br>
                    </p>

                    <form asp-action="Reserve" method="post">
                        <input type="hidden" name="ModelId" value="@ViewBag.ModelId" />

                        <div class="form-group">
                            <label>Rental Date</label>
                            <input asp-for="RentalDate" type="date" class="form-control" min="@minStart" max="@maxStart" id="RentalDate" />
                            <span asp-validation-for="RentalDate" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label>Return Date</label>
                            <input asp-for="ReturnDate" type="date" class="form-control" id="ReturnDate" />
                            <span asp-validation-for="ReturnDate" class="text-danger"></span>
                        </div>

                        <div class="info-box">
                            <span><strong>Duration: </strong><span id="daysDisplay">1</span> Day(s)</span>
                        </div>

                        <div class="form-group">
                            <label>Rental Fee (RM)</label>
                            <input id="RentalFee" class="form-control" readonly />
                        </div>
                        <div class="form-group">
                            <label>Deposit (20%)</label>
                            <input id="DepositAmount" class="form-control" readonly />
                        </div>
                        <div class="form-group">
                            <label class="grand-total">Grand Total (Pay Now)</label>
                            <input id="GrandTotal" class="form-control" readonly />
                        </div>

                        <div id="availabilityError" class="alert alert-danger mt-3" style="display:none; padding: 10px; font-size: 0.9rem;"></div>

                        <div class="button-row">
                            <button type="submit" id="btnBook" class="btn btn-primary btn-lg w-100">Book</button>
                            <a asp-controller="CarCatalog" asp-action="Index" class="btn btn-outline-secondary btn-lg">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-6 mb-4">
            <div class="calendar-card">
                <div class="calendar-header">
                    <button type="button" class="btn btn-sm btn-outline-dark" id="prevMonth">
                        <span class="material-symbols-outlined" style="font-size:1rem;">chevron_left</span>
                    </button>
                    <h4 id="monthYearDisplay">Loading...</h4>
                    <button type="button" class="btn btn-sm btn-outline-dark" id="nextMonth">
                        <span class="material-symbols-outlined" style="font-size:1rem;">chevron_right</span>
                    </button>
                </div>

                <div class="calendar-grid-header">
                    <div>Sun</div><div>Mon</div><div>Tue</div><div>Wed</div><div>Thu</div><div>Fri</div><div>Sat</div>
                </div>

                <div class="calendar-grid" id="calendarDays">
                </div>
                <br>
                <div class="mt-3 text-center">
                    <span class="badge" style="background-color: #e9ecef; color: #6c757d;">Past</span>
                    <span class="badge" style="background-color: #d1e7dd; color: #0f5132;">Available</span>
                    <span class="badge" style="background-color: #f8d7da; color: #842029;">Booked</span>
                </div>
            </div>
        </div>

    </div>
</div>

@section foot {
    <script>
        $(document).ready(function() {

            // --- 1. HELPERS ---
            Date.prototype.addDays = function (days) {
                const d = new Date(this);
                d.setDate(d.getDate() + days);
                return d;
            };

            Date.prototype.format = function () {
                return this.toISOString().substring(0, 10);
            };

            const pricePerDay = @Model.PricePerDay;
            var debounceTimer;

            // ==========================================
            // CALENDAR LOGIC
            // ==========================================
            let currentCalendarDate = new Date();

            function loadCalendar() {
                const year = currentCalendarDate.getFullYear();
                const month = currentCalendarDate.getMonth() + 1;
                const modelId = $('input[name="ModelId"]').val();

                const monthName = currentCalendarDate.toLocaleString('default', { month: 'long' });
                $('#monthYearDisplay').text(monthName + " " + year);

                $.get('/Rental/GetUnavailableDates', { modelId: modelId, month: month, year: year })
                    .done(function(busyDays) {
                        renderGrid(year, month, busyDays);
                    })
                    .fail(function() {
                        renderGrid(year, month, []);
                    });
            }

            // [CHANGE 3] Updated renderGrid to check for Past Dates
            function renderGrid(year, month, busyDays) {
                const daysContainer = $('#calendarDays');
                daysContainer.empty();

                const daysInMonth = new Date(year, month, 0).getDate();
                const firstDayIndex = new Date(year, month - 1, 1).getDay();

                // Get today's date with time stripped for accurate comparison
                const today = new Date();
                today.setHours(0, 0, 0, 0);

                for (let i = 0; i < firstDayIndex; i++) {
                    daysContainer.append('<div class="day-empty"></div>');
                }

                for (let day = 1; day <= daysInMonth; day++) {
                    let className = "day-box";
                    
                    // Create specific date object for this cell
                    const cellDate = new Date(year, month - 1, day);

                    if (cellDate < today) {
                        // If date is in the past
                        className += " day-past";
                    } 
                    else if (busyDays.includes(day)) {
                        // If date is booked
                        className += " day-busy";
                    }
                    
                    daysContainer.append(`<div class="${className}">${day}</div>`);
                }
            }

            $('#prevMonth').click(function() {
                currentCalendarDate.setMonth(currentCalendarDate.getMonth() - 1);
                loadCalendar();
            });

            $('#nextMonth').click(function() {
                currentCalendarDate.setMonth(currentCalendarDate.getMonth() + 1);
                loadCalendar();
            });

            loadCalendar();
            setInterval(loadCalendar, 5000);

            // ==========================================
            // FORM LOGIC
            // ==========================================
            function checkAvailability() {
                const start = $('#RentalDate').val();
                const end = $('#ReturnDate').val();
                const modelId = $('input[name="ModelId"]').val();
                const btn = $('#btnBook');
                const errorBox = $('#availabilityError');

                clearTimeout(debounceTimer);

                if (!start || !end) return;

                btn.prop('disabled', true)
                   .css('background-color', '#6c757d')
                   .css('border-color', '#6c757d')
                   .text('Checking...');

                errorBox.hide();

                debounceTimer = setTimeout(function() {
                    $.get('/Rental/CheckAvailability', { modelId: modelId, start: start, end: end })
                        .done(function(response) {
                            if (response.available) {
                                btn.prop('disabled', false)
                                   .css('background-color', '')
                                   .css('border-color', '')
                                   .text('Book');
                                errorBox.hide();
                            } else {
                                btn.prop('disabled', true)
                                   .css('background-color', '#dc3545')
                                   .css('border-color', '#dc3545')
                                   .text('Unavailable');
                                errorBox.text(response.message).show();
                            }
                        })
                        .fail(function() {
                             btn.prop('disabled', false)
                                .css('background-color', '#ffc107')
                                .css('color', 'black')
                                .text('Retry Check');
                        });
                }, 500);
            }

            function updateReturnLimits() {
                const ci = $('#RentalDate')[0];
                const co = $('#ReturnDate')[0];

                if (!ci.valueAsDate) return;

                const minReturn = ci.valueAsDate.format();
                const maxReturn = ci.valueAsDate.addDays(30).format();

                co.min = minReturn;
                co.max = maxReturn;

                if (co.value < minReturn) co.value = minReturn;
                if (co.value > maxReturn) co.value = maxReturn;

                updateCosts();
                checkAvailability();
            }

            function updateCosts() {
                const ci = $('#RentalDate')[0];
                const co = $('#ReturnDate')[0];

                if (ci.valueAsDate && co.valueAsDate) {
                    const ms = co.valueAsDate - ci.valueAsDate;

                    // Calculation to match "20 to 21 is 2 days" rule 
                    let days = Math.floor(ms / (24 * 60 * 60 * 1000)) + 1;

                    if (days <= 0) days = 1; 

                    $('#daysDisplay').text(days);

                    const rentalTotal = days * pricePerDay;
                    const deposit = rentalTotal * 0.20;
                    const grandTotal = rentalTotal + deposit;

                    $('#RentalFee').val(rentalTotal.toFixed(2));
                    $('#DepositAmount').val(deposit.toFixed(2));
                    $('#GrandTotal').val(grandTotal.toFixed(2));
                }
            }

            $('#RentalDate').on('change', updateReturnLimits);
            $('#ReturnDate').on('change', function() {
                updateCosts();
                checkAvailability();
            });

            updateReturnLimits();
        });
    </script>
}