@model Assignment.ViewModels.VehicleCatalogViewModel

@{
    ViewData["Title"] = "Find Your Drive";
    Layout = "_Layout";

    // 1. Get the Date to show in the box (Default to Today if null)
    string currentSearchDate = ViewBag.UserSearchDate as string ?? DateTime.Today.ToString("yyyy-MM-dd");

    // 2. Logic: Calculate Minimum Allowed Date (12PM Rule)
    string minDate = DateTime.Today.ToString("yyyy-MM-dd");
    if (DateTime.Now.Hour >= 12)
    {
        minDate = DateTime.Today.AddDays(1).ToString("yyyy-MM-dd");
    }
}

<link href="~/css/catalog.css" rel="stylesheet" />

<style>
    .search-container {
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        padding: 20px;
        margin-bottom: 30px;
    }

    .car-card {
        transition: transform 0.2s, box-shadow 0.2s;
        border: none;
        border-radius: 12px;
        overflow: hidden;
        background: #fff;
    }

        .car-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }

    .image-frame {
        height: 200px;
        background-color: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        border-bottom: 1px solid #eee;
        position: relative;
    }

        .image-frame img {
            max-height: 100%;
            max-width: 100%;
            object-fit: contain;
            padding: 10px;
        }

    .price-tag {
        color: #0d6efd;
        font-weight: 700;
        font-size: 1.2rem;
    }
</style>

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold">Find Your Perfect Car</h1>

        @* Show Alert if Controller auto-adjusted the date *@
        @if (TempData["Info"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show d-inline-block mt-3" role="alert">
                <i class="fas fa-exclamation-circle"></i> @TempData["Info"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <div class="search-container border">
        <form asp-action="Index" method="get" id="searchForm">
            <div class="row g-3 align-items-end">

                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">Pick-up Date</label>
                    <input type="date" name="pickedDate" value="@currentSearchDate"
                           min="@minDate" class="form-control bg-light border-0"
                           onchange="this.form.submit()" />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">Category</label>
                    <select asp-for="SelectedCategory" asp-items="Model.CategoryList"
                            class="form-select bg-light border-0" onchange="this.form.submit()">
                        <option value="">All Categories</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">Brand</label>
                    <select asp-for="SelectedBrandId" asp-items="Model.BrandList"
                            class="form-select bg-light border-0" onchange="this.form.submit()">
                        <option value="">All Brands</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">Search</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="bi bi-search"></i></span>
                        <input asp-for="SearchTerm" class="form-control bg-light border-0"
                               placeholder="Model..." />
                        <button type="submit" class="btn btn-primary">Go</button>
                    </div>
                </div>

            </div>
        </form>
    </div>

    <div class="row g-4">
        @if (Model.CarModels.Any())
        {
            @foreach (var item in Model.CarModels)
            {
                // Logic: Count stock from the 'Vehicles' list populated by Controller
                int stock = item.Vehicles != null ? item.Vehicles.Count : 0;
                bool isAvailable = stock > 0;

                <div class="col-md-4 col-sm-6">
                    <div class="card car-card h-100 shadow-sm @(!isAvailable ? "opacity-75" : "")">

                        <div class="image-frame">
                            @if (!string.IsNullOrEmpty(item.ImagePathFront))
                            {
                                <img src="@item.ImagePathFront" alt="@item.ModelName" onerror="this.src='/images/default-car.png'; this.onerror=null;" />
                            }
                            else
                            {
                                <span class="text-muted"><i class="bi bi-car-front fs-1"></i><br>No Image</span>
                            }

                            @if (!isAvailable)
                            {
                                <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center bg-dark bg-opacity-50 text-white fw-bold fs-5">
                                    <span class="badge bg-danger px-3 py-2">FULLY BOOKED</span>
                                </div>
                            }
                        </div>

                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="badge bg-light text-dark border">
                                    @item.Category?.CategoryName
                                </span>
                                @if (isAvailable)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                                        @stock Available
                                    </span>
                                }
                            </div>

                            <h5 class="card-title fw-bold text-dark mb-1">
                                @item.Brand?.BrandName @item.ModelName
                            </h5>

                            <p class="card-text text-muted small flex-grow-1 text-truncate">
                                @item.Description
                            </p>

                            <div class="mt-3 pt-3 border-top">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <span class="price-tag">RM @item.Price</span>
                                        <span class="text-muted small">/ day</span>
                                    </div>
                                    <a asp-action="Details" asp-route-id="@item.ModelId" class="text-decoration-none small fw-bold">
                                        View Specs <i class="bi bi-arrow-right"></i>
                                    </a>
                                </div>

                                <div class="d-grid">
                                    @if (isAvailable)
                                    {
                                        <a asp-controller="Rental"
                                           asp-action="Reserve"
                                           asp-route-modelId="@item.ModelId"
                                           asp-route-pickedDate="@currentSearchDate"
                                           class="btn btn-primary fw-bold py-2">
                                            Book for @DateTime.Parse(currentSearchDate).ToString("MMM dd")
                                        </a>
                                    }
                                    else
                                    {
                                        <button class="btn btn-secondary py-2" disabled>
                                            Unavailable on @DateTime.Parse(currentSearchDate).ToString("MMM dd")
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="py-5 bg-light rounded-3">
                    <h3 class="text-muted">No vehicles available on this date.</h3>
                    <p class="text-secondary">Try changing the date or clearing filters.</p>
                    <a asp-action="Index" class="btn btn-link text-decoration-none">Clear Filters</a>
                </div>
            </div>
        }
    </div>
</div>