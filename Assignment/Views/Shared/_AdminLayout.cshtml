@{
    var staffName = User.Identity.Name;
    var staffPhoto = User.FindFirst("PhotoURL")?.Value;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Staff Portal</title>
    <link rel="stylesheet" href="~/css/portal.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/jquery.unobtrusive-ajax.min.js"></script>

</head>
<body>

    <div class="staff-container">

        <aside class="sidebar">
            <div class="user-widget">
                <div class="user-info-row">
                    <div class="user-avatar">
                        @if (!string.IsNullOrEmpty(staffPhoto))
                        {
                            <img src="~/photos/@staffPhoto" alt="Profile" />
                        }
                        else
                        {
                            <span>@staffName?.Substring(0, 1).ToUpper()</span>
                        }
                    </div>
                    <div class="user-details">
                        <span class="user-name">@staffName</span>
                        <span class="user-role">Staff</span>
                    </div>
                </div>
            </div>
            <nav class="side-nav">
                <ul>
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="@(Context.Request.Path.ToString().Contains("Report") ? "active" : "")">
                            <a href="/Report/Index"><i class="fas fa-file-lines"></i><span>Report</span></a>
                        </li>
                        <li class="@(Context.Request.Path.ToString().Contains("PickupReturn") ? "active" : "")">
                            <a href="/PickupReturn/Index"><i class="fas fa-car"></i><span>Pickup Return</span></a>
                        </li>
                        <li class="@(Context.Request.Path.ToString().Contains("/Account/Admin") ? "active" : "")">
                            <a href="/Account/Admin"><i class="fas fa-users"></i><span>Customers</span></a>
                        </li>
                        <li class="@(Context.Request.Path.ToString().Contains("AdminStaff") ? "active" : "")">
                            <a href="/Account/AdminStaff"><i class="fas fa-user-tie"></i><span>Staff</span></a>
                        </li>
                        <li class="@(Context.Request.Path.ToString().Contains("RentalHistory") ? "active" : "")">
                            <a href="/RentalHistory/Index"><i class="fas fa-calendar"></i><span>Rental History</span></a>
                        </li>
                        <li class="@(Context.Request.Path.ToString().Contains("Vehicle") ? "active" : "")">
                            <a href="/Vehicle/"><i class="fa-solid fa-car-side"></i><span>Model</span></a>
                        </li>

                    }
                    else
                    {
                        <li class="@(Context.Request.Path.ToString().Contains("Staff") ? "active" : "")"><a href="/Account/Staff"><i class="fa-solid fa-users"></i><span>Customers</span></a></li>
                    }
                </ul>
            </nav>
            <div class="logout-wrap">
                <a href="/Account/Logout" class="logout-btn"><i class="fa-solid fa-arrow-right-from-bracket"></i> Logout</a>
            </div>
        </aside>

        <main class="main-content">

            <header class="top-bar">
                <h1>@(ViewData["Title"] ?? "Portal")</h1>
                <div class="date-display">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</div>
            </header>

            <div class="content-area">
                @RenderBody()
            </div>

        </main>
    </div>

    @RenderSection("Scripts", required: false)
    @RenderSection("foot", required: false)
</body>
</html>