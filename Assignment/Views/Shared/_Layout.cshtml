<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Car Rental</title>
    <link href="~/css/receipt.css" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/app.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

</head>
<body>
    <div class="container-1">

        <div class="navbar">
            <div class="container-2" style="display:flex; justify-content:space-between; align-items:center;">
                <a href="/" class="logo-area" style="text-decoration:none; color:inherit;">
                    <div class="text-accent">
                        <span class="material-symbols-outlined" style="font-size: 24px; color: #007BFF;">directions_car</span>
                    </div>
                    <h2>Title</h2>
                </a>

                <div style="display:flex; align-items:center; gap: 1.5rem;">
                    <nav class="nav-links">
                        <a href="/">Home</a>
                        <a href="/CarCatalog">Cars</a>
                        <a href="/About">About</a>
                        <a href="/Contact">Contact</a>
                    </nav>
                    <div style="display:flex; gap: 0.5rem;">
                        <button id="theme-toggle" class="btn-theme-toggle" title="Toggle Dark Mode">
                            <span class="material-symbols-outlined">dark_mode</span>
                        </button>
                        @{
                            // 1. Check Login Status
                            var isLoggedIn = User.Identity?.IsAuthenticated == true;

                            // 2. Get User Name & Photo from Cookie Claims
                            // User.Identity.Name automatically maps to the ClaimTypes.Name we set in AccountController
                            var userName = User.Identity?.Name;
                            var userPhoto = User.FindFirst("PhotoURL")?.Value;
                        }

                        @if (isLoggedIn)
                        {
                            <div class="user-profile-container">
                                <div class="profile-trigger" id="profileTrigger">
                                    @if (!string.IsNullOrEmpty(userPhoto))
                                    {
                                        <img src="~/photos/@userPhoto" alt="Profile" class="profile-img">
                                    }
                                    else
                                    {
                                        <img src="https://ui-avatars.com/api/?name=@userName" alt="Profile" class="profile-img">
                                    }
                                    <span class="profile-name">@userName</span>
                                    <span class="material-symbols-outlined arrow-icon">arrow_drop_down</span>
                                </div>

                                <div class="profile-dropdown" id="profileDropdown">
                                    <a href="@Url.Action("Profile", "Account")" class="dropdown-link">
                                        <span class="material-symbols-outlined">person</span>
                                        My Profile
                                    </a>

                                    <a href="@Url.Action("History", "Payment")" class="dropdown-link">
                                        <span class="material-symbols-outlined">receipt_long</span>
                                        Payment History
                                    </a>
                                    <div class="dropdown-divider"></div>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-link logout-btn">
                                            <span class="material-symbols-outlined">logout</span>
                                            Logout
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                        else
                        {
                            // --- GUEST ---
                            <a href="~/Account/Login" class="btn-login">
                                <i class="fas fa-sign-in-alt"></i> Login
                            </a>
                        }

                    </div>
                </div>
            </div>
        </div>

        <main style="display:flex; flex-direction:column; align-items:center; flex-grow: 1;">
            @RenderBody()
        </main>

        <footer class="footer-main">
            <div class="container-2">
                <div class="footer-grid">
                    <div>
                        <h3 style="font-weight:bold; margin-bottom:1rem;">Title</h3>
                        <p style="font-size:0.875rem; color:#4b5563;">Your journey, our priority. Rent premium cars effortlessly.</p>
                    </div>
                    <div class="footer-links">
                        <h3 style="font-weight:bold; margin-bottom:1rem;">Quick Links</h3>
                        <ul>
                            <li><a href="#">Home</a></li>
                            <li><a href="/CarCatalog">Cars</a></li>
                            <li><a href="#">About Us</a></li>
                        </ul>
                    </div>
                    <div class="footer-links">
                        <h3 style="font-weight:bold; margin-bottom:1rem;">Support</h3>
                        <ul>
                            <li><a href="#">Contact Us</a></li>
                            <li><a href="#">Terms</a></li>
                            <li><a href="#">Privacy</a></li>
                        </ul>
                    </div>
                    <div class="footer-links">
                        <h3 style="font-weight:bold; margin-bottom:1rem;">Contact</h3>
                        <ul>
                            <li>77, Lorong Lembah Permai 3, 11200 Tanjung Bungah, Pulau Pinang</li>
                            <li>012-456 7890</li>
                            <li>support@gmail.com</li>
                        </ul>
                    </div>
                </div>
                <div style="border-top:1px solid var(--border-color); margin-top:2rem; padding-top:1.5rem; text-align:center; font-size:0.875rem; color:var(--text-muted);">
                    <p>© 2025 Title. All Rights Reserved.</p>

                    <div class="social-links" style="margin-top: 1rem; display: flex; justify-content: center; gap: 1rem;">
                        <a class="btn-social" href="#!" aria-label="Twitter">
                            <i class="fab fa-twitter"></i>
                        </a>
                        <a class="btn-social" href="#!" aria-label="Facebook">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        <a class="btn-social" href="#!" aria-label="Instagram">
                            <i class="fab fa-instagram"></i>
                        </a>
                    </div>

                </div>
            </div>
        </footer>
    </div>


    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/js/app.js"></script>
    @await RenderSectionAsync("foot", required: false)
    @await RenderSectionAsync("Styles", required: false)
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>