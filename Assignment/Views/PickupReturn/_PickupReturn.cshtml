@model IEnumerable<Assignment.Models.Rental>

<div class="table-container">
    <table class="rental-table">
        <thead>
            <tr>
                <th>Rental ID</th>
                <th>Customer</th>
                <th>Model</th>
                <th>Vehicle Plate</th>
                <th>Booking Date</th>
                <th>Expected Pickup</th>
                <th>Expected Return</th>
                <th>Pickup Date</th>
                <th>Return Date</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="11" class="no-records">
                        No records found.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var r in Model)
                {
                    <tr class="clickable-row"
                        data-href="@Url.Action("Details", "RentalHistory", new { id = r.RentalId })">

                        <td>@r.RentalId</td>
                        <td>@r.Customer?.Name</td>
                        <td>@r.Model?.ModelName</td>
                        <td>@(r.PickupRecord?.Vehicle?.PlateNumber ?? "-")</td>
                        <td>@r.RentalDate.ToString("yyyy-MM-dd")</td>
                        <td>@r.PickupDate.ToString("yyyy-MM-dd")</td>
                        <td>@r.ReturnDate.ToString("yyyy-MM-dd")</td>
                        <td>
                            @(r.PickupRecord != null
                                                ? r.PickupRecord.PickupDateTime.ToString("yyyy-MM-dd HH:mm")
                                                : "-")
                                                  </td>
                                                  <td>
                            @(r.ReturnRecord != null
                                                ? r.ReturnRecord.ReturnDateTime.ToString("yyyy-MM-dd HH:mm")
                                                : "-")
                </td>
                <td>
                    <span class="status-badge status-@(r.Status?.ToLower().Replace(" ", ""))">
                        @r.Status
                    </span>
                </td>

                        <td class="action-cell">
                    @if (r.Status == "Booked" && r.PickupDate == DateTime.Today)
                            {
                                <a class="action-btn pickup-btn"
                                   href="@Url.Action("Pickup", "PickupReturn", new { rentalId = r.RentalId })">
                                    Pickup
                                </a>
                            }
                            else if (r.Status == "Pickup" || r.Status == "LateDue")
                            {
                                <a class="action-btn return-btn"
                                   href="@Url.Action("Return", "PickupReturn", new { rentalId = r.RentalId })">
                                    Return
                                </a>
                            }
                            else
                            {
                                <span class="no-action">-</span>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".clickable-row").forEach(row => {
            row.addEventListener("click", function (e) {
                // Don't navigate if clicking on action buttons
                if (!e.target.closest('.action-cell')) {
                    window.location = this.dataset.href;
                }
            });
        });
    });
</script>

@functions {
    public string GetStatusBadgeClass(string status)
    {
        if (string.IsNullOrEmpty(status)) return "bg-secondary";

        return status.Trim().ToLowerInvariant() switch
        {
            "booked" => "bg-info text-dark",
            "pickup" => "bg-primary",
            "pick up" => "bg-primary",
            "returned" => "bg-success",
            "latereturned" => "bg-warning text-dark",
            "cancelled" => "bg-dark",
            "expired" => "bg-secondary",
            _ => "bg-secondary"
        };
    }
}
