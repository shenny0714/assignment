@model IEnumerable<Assignment.Models.Rental>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Rental ID</th>
            <th>Customer</th>
            <th>Model</th>
            <th>Vehicle Plate</th>
            <th>Booking Date</th>
            <th>Expected Pickup</th>
            <th>Expected Return</th>
            <th>Pickup Date</th>
            <th>Return Date</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="10" class="text-center">No records found.</td></tr>
        }
        else
        {
            @foreach (var r in Model)
            {
                <tr class="clickable-row" data-href="@Url.Action("Details", "RentalHistory", new { id = r.RentalId })">
                    <td>@r.RentalId</td>
                    <td>@r.Customer?.Name</td>
                    <td>@r.Model?.ModelName</td>
                    <td>@(r.PickupRecord?.Vehicle?.PlateNumber ?? "-")</td>
                    <td>@r.RentalDate.ToString("yyyy-MM-dd")</td>
                    <td>@r.PickupDate.ToString("yyyy-MM-dd")</td>
                    <td>@r.ReturnDate.ToString("yyyy-MM-dd")</td>
                    <td>@(r.PickupRecord != null ? r.PickupRecord.PickupDateTime.ToString("yyyy-MM-dd HH:mm") : "-")</td>
                    <td>@(r.ReturnRecord != null ? r.ReturnRecord.ReturnDateTime.ToString("yyyy-MM-dd HH:mm") : "-")</td>
                    <td><span class="badge @(GetStatusBadgeClass(r.Status))">@r.Status</span></td>

                    <td>
                        @* -------- ACTION COLUMN -------- *@
                        @if (r.Status == "Booked")
                        {
                            <a class="btn btn-sm btn-primary"
                               href="@Url.Action("Pickup", "PickupReturn", new { rentalId = r.RentalId })">
                                Proceed Pickup
                            </a>
                        }
                        else if (r.Status == "Pickup" || r.Status == "LateDue")
                        {
                            <a class="btn btn-sm btn-warning"
                               href="@Url.Action("Return", "PickupReturn", new { rentalId = r.RentalId })">
                                Proceed Return
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".clickable-row").forEach(row => {
            row.addEventListener("click", function () {
                window.location = row.dataset.href;
            });
        });
    });
</script>

@functions {
    public string GetStatusBadgeClass(string status)
    {
        if (string.IsNullOrEmpty(status)) return "bg-secondary";
        status = status.Trim().ToLowerInvariant();
        return status switch
        {
            "booked" => "bg-info text-dark",
            "pick up" => "bg-primary",
            "pickup" => "bg-primary",
            "returned" => "bg-success",
            "latereturned" => "bg-warning text-dark",
            "cancelled" => "bg-dark",
            "expired" => "bg-secondary",
            _ => "bg-secondary"
        };
    }
}
