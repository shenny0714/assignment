@model Assignment.Models.Payment

@{
    ViewData["Title"] = "Payment Receipt";
}

<div class="container mt-4">
    <h3 class="mb-3">Payment Receipt</h3>

    <div class="card mb-4">
        <div class="card-body">
            <strong>Payment ID:</strong> @Model.PaymentId <br />
            <strong>Rental ID:</strong> @Model.RentalId <br />
            <strong>Customer:</strong> @Model.Rental.Customer.Name <br />
            <strong>Amount:</strong> RM @Model.Amount <br />
            <strong>Payment Type:</strong> @Model.PaymentType <br />
            <strong>Payment Method:</strong> @Model.PaymentMethod <br />
            <strong>Status:</strong> @Model.Status <br />
            <strong>Date:</strong> @Model.Date.ToString("yyyy-MM-dd HH:mm") <br />
        </div>
    </div>

    <div class="mt-3 d-flex gap-2">
        <!-- Download PDF button -->
        <a asp-action="DownloadReceiptPDF" asp-route-paymentId="@Model.PaymentId" class="btn btn-primary">
            Download as PDF
        </a>


        <!-- Send Email button -->
        <form asp-action="EmailReceipt" asp-controller="PickupReturn" method="post">
            <input type="hidden" name="paymentId" value="@Model.PaymentId" />
            <button type="submit" class="btn btn-info">
                Send Receipt via Email
            </button>
        </form>


        <!-- Back to Invoice -->
        <a asp-action="Invoice" asp-route-rentalId="@Model.RentalId" class="btn btn-secondary">
            Back to Invoice
        </a>
    </div>

    @if (TempData["Info"] != null)
    {
        <div class="alert alert-success mt-3">
            @TempData["Info"]
        </div>
    }
</div>
