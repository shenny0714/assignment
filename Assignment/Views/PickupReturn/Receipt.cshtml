@model Assignment.Models.Payment

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Payment Receipt";
}
<link rel="stylesheet" href="@Url.Content("~/css/receipt_v2.css")" />

@if (TempData["Success"] != null)
{
    <div class="success-message">
        @TempData["Success"]
    </div>
}

<div class="receipt-container">
    <div class="receipt-wrapper">
        <!-- Left Side: Receipt Details -->
        <div class="receipt-left">
            <div class="receipt-header">
                <h1>Payment Receipt</h1>
            </div>

            <div class="receipt-details">
                <div class="detail-row">
                    <span class="detail-label">Payment ID:</span>
                    <span class="detail-value">@Model.PaymentId</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Rental ID:</span>
                    <span class="detail-value">@Model.RentalId</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Customer:</span>
                    <span class="detail-value">@Model.Rental.Customer.Name</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Amount:</span>
                    <span class="detail-value amount">RM @Model.Amount</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Payment Type:</span>
                    <span class="detail-value">@Model.PaymentType</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Payment Method:</span>
                    <span class="detail-value">@Model.PaymentMethod</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Status:</span>
                    <span class="detail-value status">@Model.Status</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Date:</span>
                    <span class="detail-value">@Model.Date.ToString("yyyy-MM-dd HH:mm")</span>
                </div>
            </div>
        </div>

        <!-- Right Side: Actions -->
        <div class="receipt-right">
            <div class="actions-card">
                <h3>Actions</h3>

                <div class="action-buttons">
                    <!-- Download PDF button -->
                    <a asp-action="DownloadReceiptPDF" asp-route-paymentId="@Model.PaymentId" class="action-btn btn-primary">
                        Download as PDF
                    </a>

                    <!-- Send Email button -->
                    <form asp-action="EmailReceipt" asp-controller="PickupReturn" method="post">
                        <input type="hidden" name="paymentId" value="@Model.PaymentId" />
                        <button type="submit" class="action-btn btn-info">
                            Send Receipt via Email
                        </button>
                    </form>

                    <!-- Back to Invoice -->
                    <a asp-action="Invoice" asp-route-rentalId="@Model.RentalId" class="action-btn btn-secondary">
                        Back to Invoice
                    </a>
                </div>

                @if (TempData["Info"] != null)
                {
                    <div class="success-message">
                        @TempData["Info"]
                    </div>
                }
            </div>
        </div>
    </div>
</div>

