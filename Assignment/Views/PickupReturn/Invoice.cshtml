@model Assignment.Models.ReturnRecord

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Return Invoice";
}

<link rel="stylesheet" href="~/css/invoice.css" />

<div class="invoice-container">

    <!-- Top Row -->
    <div class="invoice-top-row">
        <h3 class="invoice-title">Return Invoice</h3>
        <button class="print-button" onclick="window.print()">
            <span class="print-icon">🖨</span>
            Print Invoice
        </button>
    </div>

    <!-- Middle Row -->
    <div class="invoice-middle-row">

        <!-- Rental Details -->
        <div class="invoice-card rental-details">
            <div class="invoice-card-header">Rental Information</div>
            <div class="invoice-card-body">
                <div class="info-item">
                    <span class="info-label">Rental ID:</span>
                    <span class="info-value">@Model.RentalId</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Customer:</span>
                    <span class="info-value">@Model.Rental.Customer.Name</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Vehicle:</span>
                    <span class="info-value">@Model.Rental.Model.ModelName</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Return Date:</span>
                    <span class="info-value">@Model.ReturnDateTime.ToString("yyyy-MM-dd HH:mm")</span>
                </div>
            </div>
        </div>

        <!-- Charges Breakdown -->
        <div class="invoice-card charges-breakdown">
            <div class="invoice-card-header">Charges Breakdown</div>
            <div class="invoice-card-body">
                <table class="invoice-table">
                    <tbody>
                        @if (Model.LateFee > 0)
                        {
                            <tr>
                                <td>Late Fee (@Model.LateReturnDay day)</td>
                                <td class="amount">RM @Model.LateFee</td>
                            </tr>
                        }
                        @if (Model.FuelCharge > 0)
                        {
                            <tr>
                                <td>Fuel Charge</td>
                                <td class="amount">RM @Model.FuelCharge</td>
                            </tr>
                        }
                        @if (Model.CleaningFee > 0)
                        {
                            <tr>
                                <td>Cleaning Fee</td>
                                <td class="amount">RM @Model.CleaningFee</td>
                            </tr>
                        }
                        @if (Model.DamageCost > 0)
                        {
                            <tr>
                                <td>Damage Cost</td>
                                <td class="amount">RM @Model.DamageCost</td>
                            </tr>
                        }
                        @if (Model.ExtraCharges > 0)
                        {
                            <tr>
                                <td>Extra Charges</td>
                                <td class="amount">RM @Model.ExtraCharges</td>
                            </tr>
                        }
                        @if (ViewBag.TotalExtra == 0)
                        {
                            <tr>
                                <td colspan="2" class="no-charges">
                                    No additional charges applied.
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="total-row">
                            <td>Total Extra Charges</td>
                            <td class="amount">RM @ViewBag.TotalExtra</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

    </div>

    <!-- Bottom Row -->
    <div class="invoice-bottom-row">

        <!-- Payment Summary -->
        <div class="invoice-card payment-summary">
            <div class="invoice-card-header">Payment Summary</div>
            <div class="invoice-card-body">
                <table class="invoice-table">
                    <tr>
                        <td>Deposit Paid</td>
                        <td class="amount">RM @ViewBag.DepositPaid</td>
                    </tr>
                    @if (ViewBag.AmountDue > 0)
                    {
                        <tr class="amount-due-row">
                            <td>Amount Due</td>
                            <td class="amount">RM @ViewBag.AmountDue</td>
                        </tr>
                    }
                    else
                    {
                        <tr class="refund-row">
                            <td>Refund Due</td>
                            <td class="amount">RM @ViewBag.Refund</td>
                        </tr>
                    }
                </table>
            </div>
        </div>

        <!-- Actions -->
        <div class="invoice-actions">

            @if (!(ViewBag.IsPaid ?? false))
            {
                @if ((ViewBag.AmountDue ?? 0) > 0)
                {
                    <a asp-controller="PickupReturn"
                       asp-action="ProceedPayment"
                       asp-route-rentalId="@Model.RentalId"
                       class="action-box pay">
                        Proceed Payment
                    </a>
                }
                else if ((ViewBag.Refund ?? 0) > 0)
                {
                    <a asp-controller="PickupReturn"
                       asp-action="ProceedPayment"
                       asp-route-rentalId="@Model.RentalId"
                       class="action-box refund">
                        Issue Refund
                    </a>
                }
            }
            else
            {
                <div class="action-box disabled">
                    Payment Settled
                </div>
            }

            <a href="@Url.Action("Index")" class="action-box back">
                Back to List
            </a>
        </div>


    </div>

</div>
