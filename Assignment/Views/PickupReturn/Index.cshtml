@model IEnumerable<Assignment.Models.Rental>

@{
    ViewData["Title"] = "Pickup & Return";
    var active = (ViewBag.ActiveTab ?? "All").ToString();
    bool todayOnly = ViewBag.TodayOnly ?? false;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://unpkg.com/html5-qrcode"></script>

@if (TempData["Success"] != null)
{
   <div>
        @TempData["Success"]
    </div>
}
<button type="button"
        id="openScannerBtn"
        class="btn btn-outline-primary ms-2">
    📷 Scan QR
</button>

<button type="button"
        id="closeScannerBtn"
        class="btn btn-outline-danger ms-2"
        style="display:none;">
    ✖ Close Scanner
</button>

<div id="reader"
     style="width:300px; display:none;"
     class="mt-3"></div>

<div class="d-flex mb-3 align-items-center">
    <!-- Search + Today Only -->
    <form id="searchForm" class="d-flex align-items-center">

        <!-- Hidden inputs -->
        <input type="hidden" name="tab" id="tabInput" value="@active" />
        <input type="hidden" name="todayOnly" id="todayOnlyInput" value="@todayOnly" />

        <!-- Search input -->
        <input type="search" name="search" placeholder="Search..."
               class="form-control d-inline-block me-2" style="width:auto;" />

        <!-- Today Only Toggle -->
        <button type="button"
                id="todayToggleBtn"
                class="btn @(todayOnly ? "btn-success" : "btn-outline-secondary")">
            @(todayOnly ? "Today Only: ON" : "Today Only: OFF")
        </button>
    </form>

    <img src="/images/loader.gif" id="loader" style="display:none;" class="ms-2" />
</div>

<!-- Tabs -->
@{
    var tabs = new List<(string Key, string Label)>
    {
        ("All","All"),
        ("Pickup","Pickup"),
        ("Return","Return"),
        ("LateDue","Late Due")
    };
}
<ul class="nav nav-tabs mb-3">
    @foreach (var tabItem in tabs)
    {
        bool isActive = active == tabItem.Key;
        <li class="nav-item">
            <a href="javascript:void(0);"
               class="nav-link @(isActive ? "active" : "")"
               data-tab="@tabItem.Key">
                @tabItem.Label
            </a>
        </li>
    }
</ul>

<!-- Partial content -->
<div id="target">
    <partial name="_PickupReturn" model="Model" />
</div>

@section foot {
    <script>
        const loader = document.getElementById('loader');

        // ---------------------------
        // AJAX form submit (Search & Today Only)
        // ---------------------------
        async function submitFormAjax() {
            const tab = document.getElementById('tabInput').value;
            const todayOnly = document.getElementById('todayOnlyInput').value;
            const searchInput = document.querySelector('input[name="search"]');
            const search = searchInput.value; // store current value

            try {
                loader.style.display = 'inline-block';
                const response = await fetch(`@Url.Action("Index", "PickupReturn")?tab=${tab}&todayOnly=${todayOnly}&search=${encodeURIComponent(search)}`, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                if (!response.ok) throw new Error('Network error');
                const data = await response.text();
                document.getElementById('target').innerHTML = data;

                // Restore search value (in case server changes it)
                searchInput.value = search;
            } catch (err) {
                document.getElementById('target').innerHTML = '<p>Error loading content.</p>';
                console.error(err);
            } finally {
                loader.style.display = 'none';
            }
        }


        // today only toggle
        const todayBtn = document.getElementById('todayToggleBtn');
        todayBtn.addEventListener('click', () => {
            const input = document.getElementById('todayOnlyInput');
            input.value = input.value === "True" ? "False" : "True";

            // update button UI immediately
            todayBtn.textContent = input.value === "True" ? "Today Only: ON" : "Today Only: OFF";
            todayBtn.className = input.value === "True" ? "btn btn-success" : "btn btn-outline-secondary";

            // submit via AJAX
            submitFormAjax();
        });

        // auto-submit
        let timer = null;
        document.querySelectorAll('input[type="search"]').forEach(input => {
            input.addEventListener('input', e => {
                clearTimeout(timer);
                timer = setTimeout(submitFormAjax, 500);
            });
        });

        // tabs click via ajax
        document.querySelectorAll('.nav-link[data-tab]').forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();

                const tab = this.dataset.tab;

                // update active tab class
                document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
                this.classList.add('active');

                // update hidden tab input
                document.getElementById('tabInput').value = tab;

                // Submit via AJAX
                submitFormAjax();
            });
        });

        // webcam integration
        let qrScanner = null;

        document.getElementById("openScannerBtn").addEventListener("click", () => {

            if (!qrScanner) {
                qrScanner = new Html5Qrcode("reader");
            }

            document.getElementById("reader").style.display = "block";
            document.getElementById("openScannerBtn").style.display = "none";
            document.getElementById("closeScannerBtn").style.display = "inline-block";

            qrScanner.start(
                { facingMode: "environment" },
                { fps: 10, qrbox: 250 },
                result => {
                    qrScanner.stop().then(() => {
                        window.location.href = result;
                    });
                }
            );
        });

        document.getElementById("closeScannerBtn").addEventListener("click", () => {
            if (qrScanner) {
                qrScanner.stop().then(() => {
                    document.getElementById("reader").style.display = "none";
                    document.getElementById("openScannerBtn").style.display = "inline-block";
                    document.getElementById("closeScannerBtn").style.display = "none";
                });
            }
        });
    </script>
}
