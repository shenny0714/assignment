@model Assignment.ViewModels.ReturnPaymentVM

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.PaymentType == "Refund" ? "Refund Payment" : "Proceed Payment";

    var paymentMethods = new List<SelectListItem>
    {
        new SelectListItem { Text = "Cash", Value = "Cash" },
        new SelectListItem { Text = "TNG", Value = "TNG" }
    };
}

<link rel="stylesheet" href="~/css/invoice.css" />

<div class="payment-wrapper">
    <div class="payment-container">
        <!-- payment details -->
        <div class="payment-left">
            <div class="payment-header">
                <h3>@ViewData["Title"]</h3>
            </div>

            <div class="detail-section">
                <h4>Payment Details</h4>

                <div class="detail-row">
                    <span class="detail-label">Rental ID</span>
                    <span class="detail-value">@Model.RentalId</span>
                </div>

                <div class="detail-row">
                    <span class="detail-label">Customer</span>
                    <span class="detail-value">@Model.CustomerName</span>
                </div>

                @if (Model.PaymentType == "Refund" && Model.Amount > 0)
                {
                    <div class="detail-row amount-row refund">
                        <span class="detail-label">Refund Amount</span>
                        <span class="detail-value">RM @Model.Amount</span>
                    </div>
                }
                else if (Model.PaymentType == "ExtraCharge" && Model.Amount > 0)
                {
                    <div class="detail-row amount-row charge">
                        <span class="detail-label">Amount Due</span>
                        <span class="detail-value">RM @Model.Amount</span>
                    </div>
                }
            </div>
        </div>

        <!-- payment form -->
        <div class="payment-right">
            <form method="post" asp-action="ProceedPayment" asp-controller="PickupReturn">
                @Html.HiddenFor(m => m.RentalId)
                @Html.HiddenFor(m => m.PaymentType)
                @Html.HiddenFor(m => m.Amount)
                @Html.HiddenFor(m => m.CustomerName)

                <div class="form-section">
                    <h4>Complete Payment</h4>

                    <div class="form-group">
                        <label asp-for="PaymentMethod">Select Payment Method</label>
                        <select asp-for="PaymentMethod" asp-items="paymentMethods">
                            <option value="">-- Choose a method --</option>
                        </select>
                        <span asp-validation-for="PaymentMethod" class="error"></span>
                    </div>

                    <div class="action-buttons">
                        <button type="submit" class="btn btn-primary">
                            @(Model.PaymentType == "Refund" ? "Confirm Refund" : "Confirm Payment")
                        </button>
                        <a href="@Url.Action("Invoice", new { rentalId = Model.RentalId })" class="btn btn-secondary">
                            Cancel
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
