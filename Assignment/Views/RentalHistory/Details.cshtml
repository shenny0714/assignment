@model Assignment.Models.Rental

@{
    ViewData["Title"] = "Rental Details";

    var status = Model.Status?.ToLower();
    bool isAdmin = ViewBag.isAdmin;
    Layout = isAdmin ? "_AdminLayout" : "_Layout";
}

<link rel="stylesheet" href="~/css/rentalHistory.css" />

<div class="details-container">
    <div class="details-header">
        <a asp-action="Index" asp-controller="RentalHistory" class="btn btn-secondary">
            &larr; Back
        </a>
        @if (!isAdmin)
        {
            <h2> Rental Details </h2>
        }
    </div>

    <div class="card">
        <div class="card-header">Rental Information</div>
        <div class="card-body">
            <p><strong>Rental ID:</strong> @Model.RentalId</p>
            <p><strong>Car Model:</strong> @(Model.Model?.ModelName ?? "-")</p>
            <p><strong>Expected Pickup Date:</strong> @Model.PickupDate.ToString("yyyy-MM-dd")</p>
            <p><strong>Expected Return:</strong> @(Model.ReturnDate.ToString("yyyy-MM-dd") ?? "-")</p>

            <p>
                <strong>Status:</strong>
                <span class="badge bg-secondary">@Model.Status</span>
            </p>

            <p><strong>Deposit:</strong> @Model.DepositAmount.ToString("C")</p>
            <p><strong>Total Price:</strong> @Model.TotalPrice.ToString("C")</p>

            @if (!isAdmin && status == "booked")
            {
                <form asp-action="Cancel"
                      asp-controller="RentalHistory"
                      method="post"
                      class="cancel-form">
                    <input type="hidden" name="id" value="@Model.RentalId" />
                    <button type="submit" class="btn btn-danger">
                        Cancel Booking
                    </button>
                </form>
            }
        </div>
    </div>

    @if (Model.PickupRecord != null)
    {
        <div class="card">
            <div class="card-header">Pickup Details</div>
            <div class="card-body">
                <p>
                    <strong>Pickup Date:</strong>
                    @Model.PickupRecord.PickupDateTime.ToString("yyyy-MM-dd HH:mm")
                </p>
                @if (isAdmin)
                {
                    <p>
                        <strong>Customer Name:</strong>
                        @Model.Customer.Name
                    </p>
                    <p>
                        <strong>Customer License:</strong>
                        <img src="~/PickupReturn/@Model.PickupRecord.CustomerDrivingLisence" class="detail-img" />
                    </p>

                    <p>
                        <strong>Vehicle ID:</strong>
                        @Model.PickupRecord.VehicleId
                    </p>
                }
                <p>
                    <strong>Vehicle Plate:</strong>
                    @(Model.PickupRecord.Vehicle?.PlateNumber ?? "-")
                </p>

                <p>
                    <strong>Odometer:</strong>
                    @Model.PickupRecord.OdometerPickup km
                </p>

                <p>
                    <strong>Fuel Level:</strong>
                    @Model.PickupRecord.FuelLevelPickup
                </p>

                <ul>
                    <li>Body: @Model.PickupRecord.BodyCondition</li>
                    <li>Interior: @Model.PickupRecord.InteriorCondition</li>
                    <li>Tyres: @Model.PickupRecord.TyreCondition</li>
                    <li>Lights: @Model.PickupRecord.LightsCondition</li>
                </ul>

                @if (isAdmin)
                {
                    <p>
                        <strong>Exterior Photo:</strong>
                        <img src="~/PickupReturn/@Model.PickupRecord.ExteriorPhotoPath" class="detail-img" />
                    </p>
                    <p>
                        <strong>Interior Photo:</strong>
                        <img src="~/PickupReturn/@Model.PickupRecord.InteriorPhotoPath" class="detail-img" />
                    </p>
                    <p>
                        <strong>Fuel Photo:</strong>
                        <img src="~/PickupReturn/@Model.PickupRecord.FuelPhotoPath" class="detail-img" />
                    </p>
                    <p>
                        <strong>Odometer Photo:</strong>
                        <img src="~/PickupReturn/@Model.PickupRecord.OdometerPhotoPath" class="detail-img" />
                    </p>
                  
                }
                @if (!string.IsNullOrEmpty(Model.PickupRecord.Remarks))
                {
                    <p><strong>Remarks:</strong> @Model.PickupRecord.Remarks</p>
                }

                @if (isAdmin)
                {
                    <hr />
                    <p><strong>Handled By:</strong> @Model.PickupRecord.Staff?.Name</p>
                }
            </div>
        </div>
    }

    @if (Model.ReturnRecord != null)
    {
        <div class="card">
            <div class="card-header">Return Details</div>
            <div class="card-body">
                <p>
                    <strong>Return Date:</strong>
                    @Model.ReturnRecord.ReturnDateTime.ToString("yyyy-MM-dd HH:mm")
                </p>

                <p>
                    <strong>Fuel Level:</strong>
                    @Model.ReturnRecord.FuelLevelReturn
                </p>

                <p>
                    <strong>Damage:</strong>
                    @(Model.ReturnRecord.HasDamage ? "Yes" : "No")
                </p>

                @if (Model.ReturnRecord.HasDamage)
                {
                    <p>
                        <strong>Damage Description:</strong>
                        @Model.ReturnRecord.DamageDescription
                    </p>
                    <p>
                        <strong>Damage Cost:</strong>
                        @Model.ReturnRecord.DamageCost?.ToString("C")
                    </p>
                }

                <hr />

                <p><strong>Late Fee:</strong> @(Model.ReturnRecord.LateFee?.ToString("C") ?? "0")</p>
                <p><strong>Fuel Charge:</strong> @(Model.ReturnRecord.FuelCharge?.ToString("C") ?? "0")</p>
                <p><strong>Cleaning Fee:</strong> @(Model.ReturnRecord.CleaningFee?.ToString("C") ?? "0")</p>

                <h5>
                    Total Charges:
                    @Model.ReturnRecord.TotalReturnCost
                </h5>

                @if (isAdmin)
                {
                    <hr />
                    <p><strong>Handled By:</strong> @Model.ReturnRecord.Staff?.Name</p>
                    <p><strong>Staff ID:</strong> @Model.ReturnRecord.StaffId</p>
                }
            </div>
        </div>
    }

    @if (Model.Payment != null && Model.Payment.Any())
    {
        <div class="card">
            <div class="card-header">Payment History</div>
            <div class="card-body p-0">
                <table class="table table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Method</th>
                            <th>Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Payment.OrderBy(p => p.Date))
                        {
                            <tr>
                                <td>@p.Date.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <span class="badge @(p.PaymentType == "Full Payment" ? "bg-primary" :
                                                                                                    p.PaymentType == "ExtraCharge" ? "bg-warning" :
                                                                                                    p.PaymentType == "Refund" ? "bg-info" : "bg-secondary")">
                                @p.PaymentType
                            </span>
                        </td>
                        <td>@p.PaymentMethod</td>
                        <td>@p.Amount</td>
                        <td>
                            <span class="badge bg-success">@p.Status</span>
                        </td>
                    </tr>
                                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <em>No payment records found.</em>
            </div>
        </div>
    }

    @{
        var fullPayment = Model.Payment.FirstOrDefault(p => p.PaymentType == "Full Payment");
        var returnPayment = Model.Payment
        .FirstOrDefault(p => p.PaymentType == "ExtraCharge" || p.PaymentType == "Refund");
    }
    <p><strong>Booking Payment:</strong> @(fullPayment != null ? "Paid" : "Unpaid")</p>
    <p><strong>Return Settlement:</strong> @(returnPayment != null ? "Settled" : "Pending")</p>
</div>

@section foot {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".cancel-form").forEach(form => {
                form.addEventListener("submit", function (e) {
                    const confirmed = confirm(
                        "Cancel this booking?\nDeposit refund depends on policy."
                    );

                    if (!confirmed) {
                        e.preventDefault();
                    }
                });
            });
        });
    </script>
}
