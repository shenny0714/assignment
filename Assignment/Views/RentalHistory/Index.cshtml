@model IEnumerable<Assignment.Models.Rental>

@{
    ViewData["Title"] = "Rental History";
    var active = (ViewBag.ActiveTab ?? "All").ToString();
    bool isAdmin = false;
    // ViewBag.IsAdmin ??
    // change after security added
}

<link rel="stylesheet" href="~/css/rentalHistory.css" />

<div class="rental-history-container">
    <div class="page-header">
        <h2>Rental History</h2>
    </div>

    <div class="search-section">
        <form asp-action="Index"
              asp-controller="RentalHistory"
              data-ajax="true"
              data-ajax-update="#target"
              data-ajax-loading="#loader"
              class="search-form">
            <input type="hidden" name="tab" value="@active" />
            <div class="search-box">
                @Html.TextBox("search", "", new { type = "search", id = "search", autofocus = "", placeholder = "Search rentals...", @class = "search-input" })
                <button type="submit" class="search-btn">Search</button>
            </div>
            <img src="/images/loader.gif" id="loader" class="loader" style="display: none">
        </form>
    </div>

    <div class="filter-section">
        <form data-ajax="true"
              data-ajax-update="#target"
              data-ajax-loading="#loader"
              method="get"
              class="filter-form">
            <input type="hidden" name="tab" id="tabInput" value="@active" />
            <div class="filter-grid">
                <div class="filter-field">
                    <label>Pickup From:</label>
                    <input type="date" name="pickupFrom" class="date-input" />
                </div>
                <div class="filter-field">
                    <label>Pickup To:</label>
                    <input type="date" name="pickupTo" class="date-input" />
                </div>
                <div class="filter-field">
                    <label>Return From:</label>
                    <input type="date" name="returnFrom" class="date-input" />
                </div>
                <div class="filter-field">
                    <label>Return To:</label>
                    <input type="date" name="returnTo" class="date-input" />
                </div>
                <div class="filter-field filter-button-field">
                    <button type="submit" class="filter-btn">Filter</button>
                </div>
            </div>
        </form>
    </div>

    @{
        var tabs = new List<(string Key, string Label)>
        {
        ("All", "All"),
        ("Booked", "Booked"),
        ("Pickup", "Pickup"),
        ("Returned", "Returned"),
        ("LateDue", "Late Due"),
        ("LateReturned", "Late Returned"),
        ("Cancelled","Cancelled"),
        ("Expired","Expired")
        };
    }

    <div class="tabs-section">
        <ul class="nav nav-tabs">
            @foreach (var tabItem in tabs)
            {
                bool isActive = active == tabItem.Key;

                if ((tabItem.Key == "LateDue" && active == "LateDue") ||
                (tabItem.Key == "LateReturned" && active == "LateReturned"))
                {
                    isActive = true;
                }

                <li class="nav-item">
                    <a class="nav-link @(isActive ? "active" : "")"
                       data-ajax="true"
                       data-ajax-update="#target"
                       data-ajax-loading="#loader"
                       href="@Url.Action("Index", "RentalHistory", new { tab = tabItem.Key })">
                        @tabItem.Label
                    </a>
                </li>
            }
        </ul>
    </div>

    <div id="target">
        <partial name="_RentalHistory" model="Model" />
    </div>
</div>

@section foot {
    <script>
        let timer = null;

        $('#search').on('input', e => {
            clearTimeout(timer);
            timer = setTimeout(() => $(e.target.form).submit(), 500);
        });

        document.querySelectorAll('.nav-link[data-ajax="true"]').forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();

                document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
                this.classList.add('active');

                const tab = new URL(this.href).searchParams.get('tab');

                document.querySelectorAll('input[name="tab"]').forEach(inp => inp.value = tab);

                $.get(this.href, function(data) {
                    $('#target').html(data);
                });
            });
        });
    </script>
}
