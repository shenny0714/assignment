@model IEnumerable<Assignment.Models.Rental>

@{
    ViewData["Title"] = "Rental History";
    var active = (ViewBag.ActiveTab ?? "All").ToString();
    bool isAdmin = ViewBag.isAdmin;
    Layout = isAdmin? "_AdminLayout":"_Layout";

}

<link rel="stylesheet" href="~/css/rentalHistory.css" />

<div class="rental-history-container">
    <div class="search-section">
        <form asp-action="Index"
              asp-controller="RentalHistory"
              method="get"
              class="search-form">
            <input type="hidden" name="tab" value="@active" />
            <div class="search-box">
                @Html.TextBox("search", "", new {
                type = "search",
                                id = "search",
                                autofocus = "",
                                placeholder = "Search rentals...",
                                @class = "search-input"
                                })
                <button type="submit" class="search-btn">Search</button>
            </div>
        </form>
    </div>

    <div class="filter-section">
        <form asp-action="Index"
              asp-controller="RentalHistory"
              method="get"
              class="filter-form">
            <input type="hidden" name="tab" id="tabInput" value="@active" />
            <div class="filter-grid">
                <div class="filter-field">
                    <label>Pickup From:</label>
                    <input type="date" name="pickupFrom" class="date-input" />
                </div>
                <div class="filter-field">
                    <label>Pickup To:</label>
                    <input type="date" name="pickupTo" class="date-input" />
                </div>
                <div class="filter-field">
                    <label>Return From:</label>
                    <input type="date" name="returnFrom" class="date-input" />
                </div>
                <div class="filter-field">
                    <label>Return To:</label>
                    <input type="date" name="returnTo" class="date-input" />
                </div>
                <div class="filter-field filter-button-field">
                    <button type="submit" class="filter-btn">Filter</button>
                </div>
            </div>
        </form>
    </div>

    @{
        var tabs = new List<(string Key, string Label)>
        {
        ("All", "All"),
        ("Booked", "Booked"),
        ("Pickup", "Pickup"),
        ("Returned", "Returned"),
        ("LateDue", "Late Due"),
        ("LateReturned", "Late Returned"),
        ("Cancelled","Cancelled"),
        ("Expired","Expired")
        };
    }

    <div class="tabs-section">
        <ul class="nav nav-tabs">
            @foreach (var tabItem in tabs)
            {
                bool isActive = active == tabItem.Key;
                <li class="nav-item">
                    <a class="nav-link @(isActive ? "active" : "")"
                       href="@Url.Action("Index", "RentalHistory", new { tab = tabItem.Key })">
                        @tabItem.Label
                    </a>
                </li>
            }
        </ul>
    </div>

    <div id="target">
        <partial name="_RentalHistory" model="Model" />
    </div>
</div>

@section foot {
    <script>
        // ========= AJAX FETCH HELPER =========
        function ajaxFetch(url) {
            return fetch(url, {
                headers: {
                    "X-Requested-With": "XMLHttpRequest"
                }
            }).then(r => r.text());
        }

        // ========= SEARCH (debounced) =========
        let timer = null;
        document.getElementById('search').addEventListener('input', e => {
            clearTimeout(timer);
            timer = setTimeout(() => {
                const form = e.target.form;
                const params = new URLSearchParams(new FormData(form));
                const url = form.action + '?' + params.toString();

                ajaxFetch(url).then(html => {
                    document.getElementById('target').innerHTML = html;
                });
            }, 400);
        });

        // ========= FILTER =========
        document.querySelector('.filter-form').addEventListener('submit', e => {
            e.preventDefault();

            const form = e.target;
            const params = new URLSearchParams(new FormData(form));
            const url = form.action + '?' + params.toString();

            ajaxFetch(url).then(html => {
                document.getElementById('target').innerHTML = html;
            });
        });

        // ========= TABS =========
        document.querySelectorAll('.nav-link').forEach(link => {
            link.addEventListener('click', e => {
                e.preventDefault();

                const tab = new URL(link.href).searchParams.get('tab');

                document.querySelectorAll('input[name="tab"]').forEach(i => {
                    i.value = tab;
                });

                ajaxFetch(link.href).then(html => {
                    document.getElementById('target').innerHTML = html;
                });

                document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
                link.classList.add('active');
            });
        });
    </script>
}
