@model Assignment.ViewModels.VehicleCatalogViewModel

@{
    ViewData["Title"] = "Find Your Drive";

    string currentSearchDate = ViewBag.UserSearchDate as string
        ?? DateTime.Today.ToString("yyyy-MM-dd");
    // 2. Logic: Calculate Minimum Allowed Date (12PM Rule) 
    string minDate = DateTime.Today.ToString("yyyy-MM-dd");
}

<style>
    /* ===== Page Title ===== */
    h1 {
        letter-spacing: 0.5px;
    }

    /* ===== Search Container ===== */
    .search-container {
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 30px;
        border: 1px solid var(--border-color, #dee2e6);
    }

        /* Inputs inherit theme */
        .search-container .form-control,
        .search-container .form-select,
        .search-container .input-group-text {
            background-color: inherit;
            color: inherit;
            border: 1px solid var(--border-color, #dee2e6);
            border-radius: 10px;
            height: 44px;
        }

    /* ===== Card ===== */
    .car-card {
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid var(--border-color, #dee2e6);
        background-color: inherit;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .car-card:hover {
            transform: translateY(-4px);
        }

    /* ===== Image ===== */
    .image-frame {
        height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-bottom: 1px solid var(--border-color, #dee2e6);
    }

        .image-frame img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            padding: 10px;
        }

    /* ===== Badge ===== */
    .badge {
        background-color: inherit;
        color: inherit;
        border: 1px solid var(--border-color, #dee2e6);
        border-radius: 50px;
        padding: 6px 14px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    /* ===== Card Body ===== */
    .card-body {
        padding: 18px 20px 20px;
    }

    /* ===== Price ===== */
    .price-tag {
        font-weight: 700;
    }

    /* ===== Buttons ===== */
    .btn-outline-primary {
        border-radius: 50px;
        padding: 6px 18px;
        font-size: 0.9rem;
        font-weight: 600;
    }

    /* ===== Empty State ===== */
    .bg-light.rounded-3 {
        background-color: inherit !important;
        border: 1px solid var(--border-color, #dee2e6);
    }

    /* ===== Responsive ===== */ @@media (max-width: 768px) {
        .image-frame {
            height: 180px;
        }

        .search-container {
            padding: 20px;
        }
    }

    }
</style>

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold">Find Your Perfect Car</h1>
    </div>

    <!-- ===== Search Bar ===== -->
    <div class="search-container">
        <form asp-action="Index" method="get">
            <div class="row g-3 align-items-end">

                <div class="col-md-3">
                    <input type="date"
                           name="pickedDate"
                           value="@currentSearchDate"
                           min="@minDate"
                           class="form-control" />
                </div>

                <div class="col-md-3">
                    <select asp-for="SelectedCategory"
                            asp-items="Model.CategoryList"
                            class="form-select">
                        <option value="">All Categories</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <select asp-for="SelectedBrandId"
                            asp-items="Model.BrandList"
                            class="form-select">
                        <option value="">All Brands</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>
                        <input asp-for="SearchTerm"
                               class="form-control"
                               placeholder="e.g. Civic, Camry..." />
                    </div>
                </div>

                <div class="col-md-12 text-end mt-2">
                    <button type="submit" class="btn btn-primary fw-bold px-5">
                        Search
                    </button>
                </div>

            </div>
        </form>
    </div>

    <!-- ===== Vehicle Cards ===== -->
    <div class="row g-4">
        @if (Model.CarModels.Any())
        {
            foreach (var item in Model.CarModels)
            {
                int stock = item.Vehicles?.Count ?? 0;
                bool isAvailable = stock > 0;

                <div class="col-md-4 col-sm-6">
                    <div class="card car-card h-100">

                        <div class="image-frame">
                            @if (!string.IsNullOrEmpty(item.ImagePathFront))
                            {
                                <img src="@item.ImagePathFront"
                                     alt="@item.ModelName"
                                     onerror="this.src='/images/default-car.png'; this.onerror=null;" />
                            }
                            else
                            {
                                <span class="text-muted">
                                    <i class="bi bi-car-front fs-1"></i><br />No Image
                                </span>
                            }
                        </div>

                        <div class="card-body d-flex flex-column">

                            <div class="mb-2">
                                <span class="badge">
                                    @item.Category?.CategoryName
                                </span>
                            </div>

                            <h5 class="fw-bold mb-1">
                                @item.Brand?.BrandName @item.ModelName
                            </h5>

                            <p class="small flex-grow-1 text-truncate">
                                @item.Description
                            </p>

                            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                <div>
                                    <span class="price-tag">RM @item.Price</span>
                                    <span class="small">/ day</span>
                                </div>

                                <a asp-action="Details"
                                   asp-route-id="@item.ModelId"
                                   class="btn btn-outline-primary">
                                    Details
                                </a>
                            </div>

                            <div class="d-grid mt-3">
                                @if (isAvailable)
                                {
                                    <a asp-controller="Rental"
                                       asp-action="Reserve"
                                       asp-route-modelId="@item.ModelId"
                                       asp-route-pickedDate="@currentSearchDate"
                                       class="btn btn-primary fw-bold">
                                        Book for @DateTime.Parse(currentSearchDate).ToString("MMM dd")
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-secondary" disabled>
                                        Fully booked on @DateTime.Parse(currentSearchDate).ToString("MMM dd")
                                    </button>
                                }
                            </div>

                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="py-5 rounded-3">
                    <h3 class="text-muted">No vehicles found.</h3>
                    <a asp-action="Index" class="btn btn-link">Clear Filters</a>
                </div>
            </div>
        }
    </div>
</div>
