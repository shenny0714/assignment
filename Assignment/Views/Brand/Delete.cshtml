@model Assignment.Models.Brand

@{
    Layout = "_AdminLayout";
}

<div class="product-management-container">
    <div class="top-bar">
        <h2 style="color: #dc3545;">Delete Brand</h2>
        <div class="too-bar-btn">
            <a asp-action="Index" class="btn-filter" style="background-color:#6c757d; text-decoration:none;">⬅ Back to List</a>
        </div>
    </div>

    <div style="background-color: #fff; padding: 20px; border-radius: 8px; margin-top: 20px;">
        <h3 class="text-danger">Are you sure you want to delete this?</h3>
        <p style="color: #666; margin-bottom: 20px;">This action cannot be undone.</p>

        <hr />

        <dl class="row" style="margin-bottom: 30px;">
            <dt class="col-sm-2" style="font-weight:bold;">
                Brand Name
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.BrandName)
            </dd>

            <dt class="col-sm-2" style="font-weight:bold;">
                Brand ID
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.BrandId)
            </dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="BrandId" />

            <input type="submit" value="Confirm Delete" class="btn-delete" style="cursor:pointer; padding: 10px 20px;" />
            <a asp-action="Index" style="margin-left: 10px; text-decoration:none; color: #6c757d;">Cancel</a>
        </form>
    </div>
</div>